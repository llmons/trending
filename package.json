{
  "name": "trending",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:mock": "TRENDING_MOCK=1 astro dev",
    "build": "astro build",
    "build:mock": "TRENDING_MOCK=1 astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,svelte,astro}\"",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.6",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "astro": "^7.4.2",
    "svelte": "5.59.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@eslint/js": "^10",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "typescript-eslint": "^8"
  }
}
