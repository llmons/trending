---
import "@/styles/global.css"

import SiteFooter from "@/components/site-footer.astro"
import SiteHeader from "@/components/site-header.astro"

interface Props {
  title?: string
  description?: string
  /** Keep sample pages out of search results (local mock builds). */
  noindex?: boolean
}

const {
  title = "trending — daily rankings of programming languages and frameworks",
  description = "Daily rankings built from public APIs: mainstream programming languages by new GitHub repositories, Go frameworks by pkg.go.dev imported-by counts, and JS frameworks by npm downloads.",
  noindex = false,
} = Astro.props

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null
---

<!doctype html>
<html lang="en" data-type="software">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#08090c" />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="trending" />
    <meta name="twitter:card" content="summary" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl.href} />}
    <script is:inline>
      // Resolve the theme and arm motion before first paint. Dark is the
      // default; a stored choice or `?theme=light|dark` wins.
      ;(() => {
        const root = document.documentElement
        root.classList.add("js")
        try {
          const forced = new URLSearchParams(location.search).get("theme")
          const stored = localStorage.getItem("trending:theme")
          const dark = forced
            ? forced === "dark"
            : stored
              ? stored === "dark"
              : !window.matchMedia("(prefers-color-scheme: light)").matches
          root.classList.toggle("dark", dark)
          root.style.colorScheme = dark ? "dark" : "light"
        } catch {
          root.classList.add("dark")
        }
      })()
    </script>
  </head>
  <body class="flex min-h-svh flex-col bg-canvas text-ink antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:border focus:border-line focus:bg-panel focus:px-4 focus:py-2.5 focus:font-mono focus:text-[0.6875rem] focus:tracking-[0.12em] focus:uppercase"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="content" class="grow">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "@/scripts/behavior"
    </script>
  </body>
</html>
