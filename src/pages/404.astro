---
import Icon from "@/components/icon.astro"
import Layout from "@/layouts/main.astro"

const base = import.meta.env.BASE_URL
---

<Layout title="404 — trending" description="This page does not exist.">
  <section class="relative overflow-hidden">
    <div
      class="grid-field pointer-events-none absolute inset-0 -z-10"
      aria-hidden="true"
    ></div>

    <div class="wrap flex min-h-[70svh] flex-col justify-center py-20">
      <p class="label text-accent">Error 404</p>

      <p
        class="num mt-6 text-[clamp(5rem,22vw,15rem)] leading-[0.8] font-medium text-line select-none"
        aria-hidden="true"
      >
        404
      </p>

      <h1 class="mt-8 text-headline font-semibold text-ink">
        This page does not exist.
      </h1>
      <p class="mt-4 max-w-lg text-lede text-ink-soft">
        Unlike the languages in the ranking, this page has zero repositories.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={base} class="btn btn-solid">
          Back to the ranking
          <Icon name="arrow-right" size={14} />
        </a>
        <a href={`${base}methodology/`} class="btn btn-line">
          Methodology
        </a>
      </div>
    </div>
  </section>
</Layout>
