---
import Icon from "@/components/icon.astro"
import JsFrameworkTable from "@/components/js-framework-table.astro"
import SectionHeading from "@/components/section-heading.astro"
import Layout from "@/layouts/main.astro"
import { formatCompact, formatDate, formatFull } from "@/lib/format"
import { loadJsFrameworkRankings } from "@/lib/npm"

const data = loadJsFrameworkRankings()
const { meta, ranked, total } = data
const leader = ranked[0]
const base = import.meta.env.BASE_URL

const windowLabel = `${formatDate(meta.window.from)} → ${formatDate(meta.window.to)}`

const description =
  `Ranking of JS/TS full-stack meta-frameworks by npm downloads of their ` +
  `meta-framework package over the trailing 30 days (${windowLabel}). ` +
  `A snapshot rebuilt daily.`

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "trending — JS full-stack framework ranking",
  description,
  dateCreated: meta.generatedAt,
  temporalCoverage: `${meta.window.from}/${meta.window.to}`,
  isAccessibleForFree: true,
}
---

<Layout
  title="trending — JS full-stack frameworks ranked by npm downloads"
  description={description}
>
  <section class="relative overflow-hidden border-b border-line">
    <div
      class="grid-field pointer-events-none absolute inset-0 -z-10"
      aria-hidden="true"
    ></div>

    <div class="wrap py-14 md:py-20">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <span class="label text-accent">Index 05</span>
            <span class="label">npm downloads</span>
            <span class="label">Window {windowLabel}</span>
          </div>

          <h1 class="mt-6 max-w-2xl text-headline font-semibold text-ink">
            Full-stack JS frameworks, ranked by npm downloads.
          </h1>

          <p class="mt-5 max-w-2xl text-lede text-ink-soft">
            Installs of each framework's own meta-framework package over the
            registry's trailing 30 days. Each entry is counted at the
            meta-framework, not the renderer, so the comparison stays
            like-for-like.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#frameworks" class="btn btn-line">
              See the ranking
              <Icon name="arrow-down" size={13} />
            </a>
            <a href={`${base}methodology/#js-frameworks`} class="btn btn-quiet">
              Full methodology
              <Icon name="arrow-right" size={13} />
            </a>
          </div>
        </div>

        <aside class="self-start lg:col-span-5">
          <dl class="grid grid-cols-2 gap-px border border-line bg-line">
            <div class="bg-canvas p-5">
              <dt class="label">Most installed</dt>
              <dd class="num mt-4 text-[1.3125rem] leading-none text-ink">
                {leader.npmPackage}
              </dd>
              <dd class="num mt-2 text-[0.75rem] text-ink-soft">
                {formatFull(leader.downloads)} downloads
              </dd>
            </div>
            <div class="bg-canvas p-5">
              <dt class="label">Group total</dt>
              <dd class="num mt-4 text-[1.3125rem] leading-none text-ink">
                {formatCompact(total)}
              </dd>
              <dd class="mt-2 text-[0.75rem] text-ink-soft">
                across {meta.frameworksTracked} meta-frameworks
              </dd>
            </div>
          </dl>

          <p class="mt-4 text-[0.6875rem] leading-relaxed text-ink-faint">
            Five keyless requests, paced at one per second. The window is the
            registry's own trailing 30 days, printed verbatim — never a calendar
            month. Downloads are install events, not projects.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section id="frameworks" class="scroll-mt-24">
    <div class="wrap py-16 md:py-24">
      <SectionHeading
        index="01"
        title="Full-stack frameworks"
        aside={`${ranked.length} frameworks · ${formatFull(total)} downloads`}
        description="Meta-frameworks that ship routing, rendering, and a server runtime in one package. Share compares each framework against the group total over the same 30-day window."
      />
      <div class="border border-line p-4 sm:p-6">
        <JsFrameworkTable data={data} />
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-panel">
    <div class="wrap grid gap-8 py-14 md:grid-cols-12 md:py-16">
      <div class="md:col-span-4">
        <p class="label">Reading the numbers</p>
        <h2 class="mt-3 text-title font-semibold text-ink">
          Installs are not projects
        </h2>
      </div>
      <div class="md:col-span-8">
        <p class="max-w-2xl text-meta leading-relaxed text-ink-soft">
          npm counts install events. CI re-installs, container layers,
          lockfile-free deployments, transitive dependencies, and registry
          mirrors all inflate the totals, and nothing is deduplicated per
          machine. Read the ranking as adoption pressure across the ecosystem,
          not as a headcount of applications, and do not compare its totals with
          the language counts or the imported-by counts — those measure
          different things on different bases.
        </p>
      </div>
    </div>
  </section>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(datasetSchema)}
  />
</Layout>
