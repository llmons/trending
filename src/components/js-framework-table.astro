---
import Icon from "@/components/icon.astro"
import { formatFull, formatPercent } from "@/lib/format"
import type { JsFrameworkRankings } from "@/lib/js-ranking"
import { npmPackageUrl } from "@/lib/npm"

interface Props {
  data: JsFrameworkRankings
}

const { data } = Astro.props
const { ranked, total } = data

// Log-scaled bars: the leader alone is ~80% of the group, so a linear bar
// would flatten every other framework into an unreadable sliver.
const logs = ranked.map((framework) =>
  Math.log10(Math.max(framework.downloads, 1))
)
const logMax = Math.max(...logs)
const logMin = Math.min(...logs)
const spread = logMax - logMin

function barWidth(downloads: number): number {
  if (spread <= 0) return 100
  const ratio = (Math.log10(Math.max(downloads, 1)) - logMin) / spread
  return Math.round((6 + ratio * 94) * 10) / 10
}
---

<table class="dtable dtable--stack">
  <thead>
    <tr>
      <th scope="col">№</th>
      <th scope="col">Framework</th>
      <th scope="col">npm package</th>
      <th class="r" scope="col">
        Downloads (30d)
      </th>
      <th scope="col">Share of group</th>
    </tr>
  </thead>
  <tbody>
    {ranked.map((framework, index) => (
      <tr>
        <td data-label="Rank">
          <span
            class:list={[
              "num text-[0.8125rem]",
              framework.rank <= 3 ? "text-accent" : "text-ink-faint",
            ]}
          >
            {String(framework.rank).padStart(2, "0")}
          </span>
        </td>
        <td data-label="Framework">
          <span class="flex items-center gap-2.5">
            <span
              class="size-1.5 shrink-0"
              style={`background-color: ${framework.color}`}
              aria-hidden="true"
            />
            <a
              href={framework.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group/link inline-flex items-center gap-1.5 text-[0.9375rem] font-medium text-ink"
            >
              <span class="link-draw">{framework.name}</span>
              <Icon
                name="arrow-up-right"
                size={13}
                class="text-ink-faint transition-colors group-hover/link:text-accent"
              />
            </a>
          </span>
        </td>
        <td data-label="Package">
          <a
            href={npmPackageUrl(framework.npmPackage)}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[0.75rem] text-ink-soft transition-colors hover:text-accent"
          >
            {framework.npmPackage}
          </a>
        </td>
        <td data-label="Downloads" class="r">
          <span class="num text-[0.875rem] text-ink">
            {formatFull(framework.downloads)}
          </span>
        </td>
        <td data-label="Share">
          <div class="flex items-center gap-3">
            <span class="h-[3px] min-w-10 flex-1 overflow-hidden bg-panel-2">
              <span
                class="bar"
                style={`--w:${barWidth(framework.downloads).toFixed(2)}%;--i:${index}`}
              />
            </span>
            <span class="num w-11 text-right text-[0.75rem] text-ink-faint">
              {formatPercent(total > 0 ? framework.downloads / total : 0)}
            </span>
          </div>
        </td>
      </tr>
    ))}
  </tbody>
</table>

<p class="mt-4 max-w-3xl text-meta leading-relaxed text-ink-faint">
  Downloads = npm installs of each framework's meta-framework package over the
  trailing 30 days reported by the registry. Bars are log-scaled so the smaller
  frameworks stay legible; share uses the raw counts.
</p>
