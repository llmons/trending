---
import { RiExternalLinkLine } from "@remixicon/react"

import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"
import type { JsFrameworkRankings } from "@/lib/js-ranking"
import { formatFull, formatPercent } from "@/lib/format"
import { npmPackageUrl } from "@/lib/npm"
import { cn } from "@/lib/utils"

interface Props {
  data: JsFrameworkRankings
}

const { data } = Astro.props
const { ranked, total } = data

// Log-scaled bars: the leader alone is ~80% of the group, so a linear bar
// would flatten every other framework into an unreadable sliver.
const logs = ranked.map((framework) =>
  Math.log10(Math.max(framework.downloads, 1))
)
const logMax = Math.max(...logs)
const logMin = Math.min(...logs)
const spread = logMax - logMin

function barWidth(downloads: number): number {
  if (spread <= 0) return 100
  const ratio = (Math.log10(Math.max(downloads, 1)) - logMin) / spread
  return Math.round((6 + ratio * 94) * 10) / 10
}
---

<Table className="min-w-[760px]">
  <TableHeader>
    <TableRow className="border-border">
      <TableHead className="w-16">№</TableHead>
      <TableHead>Framework</TableHead>
      <TableHead>npm package</TableHead>
      <TableHead className="text-right">Downloads (30d)</TableHead>
      <TableHead className="w-56">Share of the group</TableHead>
    </TableRow>
  </TableHeader>
  <TableBody>
    {ranked.map((framework) => (
      <TableRow className="group/row border-border/60">
        <TableCell
          className={cn(
            "font-serif text-lg tabular-nums transition-colors group-hover/row:text-viz-accent",
            framework.rank <= 3 ? "text-viz-accent" : "text-muted-foreground"
          )}
        >
          {String(framework.rank).padStart(2, "0")}
        </TableCell>
        <TableCell>
          <span class="flex items-center gap-3">
            <span
              aria-hidden
              class="size-2.5 shrink-0 rounded-full"
              style={`background-color: ${framework.color}`}
            />
            <a
              href={framework.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-heading text-sm font-semibold tracking-wider uppercase transition-colors hover:text-foreground"
            >
              {framework.name}
              <RiExternalLinkLine className="size-3.5 text-muted-foreground" />
            </a>
          </span>
        </TableCell>
        <TableCell>
          <a
            href={npmPackageUrl(framework.npmPackage)}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs text-muted-foreground transition-colors hover:text-foreground"
          >
            {framework.npmPackage}
          </a>
        </TableCell>
        <TableCell className="text-right font-serif text-base tabular-nums">
          {formatFull(framework.downloads)}
        </TableCell>
        <TableCell>
          <div class="flex items-center gap-3">
            <div class="h-1.5 min-w-12 grow bg-muted">
              <div
                class="h-full bg-viz-accent opacity-80 transition-opacity group-hover/row:opacity-100"
                style={`width: ${barWidth(framework.downloads)}%`}
              />
            </div>
            <span class="w-16 text-right font-serif text-sm text-muted-foreground tabular-nums">
              {formatPercent(total > 0 ? framework.downloads / total : 0)}
            </span>
          </div>
        </TableCell>
      </TableRow>
    ))}
  </TableBody>
  <TableCaption>
    Downloads = npm installs of each framework's meta-framework package over the
    trailing 30 days reported by the registry. Share = each framework's
    percentage of the group total. Bars are log-scaled so the smaller frameworks
    stay legible.
  </TableCaption>
</Table>
