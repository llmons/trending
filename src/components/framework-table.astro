---
import Icon from "@/components/icon.astro"
import type { FrameworkGroup } from "@/lib/framework-ranking"
import { formatFull, formatPercent } from "@/lib/format"
import { pkgGoDevUrl } from "@/lib/pkgsite"

interface Props {
  group: FrameworkGroup
}

const { group } = Astro.props
---

<table class="dtable dtable--stack">
  <thead>
    <tr>
      <th scope="col">№</th>
      <th scope="col">Framework</th>
      <th scope="col">Canonical package</th>
      <th class="r" scope="col">
        Importers
      </th>
      <th scope="col">Share of group</th>
    </tr>
  </thead>
  <tbody>
    {group.ranked.map((framework, index) => {
      const share = group.total > 0 ? framework.importers / group.total : 0
      return (
        <tr>
          <td data-label="Rank">
            <span
              class:list={[
                "num text-[0.8125rem]",
                framework.rank <= 3 ? "text-accent" : "text-ink-faint",
              ]}
            >
              {String(framework.rank).padStart(2, "0")}
            </span>
          </td>
          <td data-label="Framework">
            <span class="flex items-center gap-2.5">
              <span
                class="size-1.5 shrink-0"
                style={`background-color: ${framework.color}`}
                aria-hidden="true"
              />
              <a
                href={framework.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group/link inline-flex items-center gap-1.5 text-[0.9375rem] font-medium text-ink"
              >
                <span class="link-draw">{framework.name}</span>
                <Icon
                  name="arrow-up-right"
                  size={13}
                  class="text-ink-faint transition-colors group-hover/link:text-accent"
                />
              </a>
            </span>
          </td>
          <td data-label="Package">
            <a
              href={pkgGoDevUrl(framework.importPath)}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[0.75rem] text-ink-soft transition-colors hover:text-accent"
            >
              {framework.importPath}
            </a>
          </td>
          <td data-label="Importers" class="r">
            <span class="num text-[0.875rem] text-ink">
              {formatFull(framework.importers)}
            </span>
          </td>
          <td data-label="Share">
            <div class="flex items-center gap-3">
              <span class="h-[3px] min-w-10 flex-1 overflow-hidden bg-panel-2">
                <span
                  class="bar"
                  style={`--w:${Math.max(share * 100, 1.2).toFixed(2)}%;--i:${index}`}
                />
              </span>
              <span class="num w-11 text-right text-[0.75rem] text-ink-faint">
                {formatPercent(share)}
              </span>
            </div>
          </td>
        </tr>
      )
    })}
  </tbody>
</table>

<p class="mt-4 max-w-3xl text-meta leading-relaxed text-ink-faint">
  Importers = packages that import the framework's canonical package, per
  pkg.go.dev. Share compares each count against the "{group.label}" group total.
</p>
