---
import { formatCompact, formatPercent } from "@/lib/format"
import { STAR_TIERS, type Rankings } from "@/lib/tiers"

interface Props {
  tiers: Rankings["tiers"]
}

const { tiers } = Astro.props

const rows = STAR_TIERS.map((tier) => ({
  label: tier.label,
  total: tiers[tier.id].total,
  share: tiers[tier.id].total / Math.max(tiers.ge2.total, 1),
}))
---

<article class="breakdown md:col-span-5">
  <p class="label">Thresholds</p>
  <h3 class="mt-3 text-title font-semibold text-ink">What cleared each tier</h3>
  <p class="mt-2 text-meta leading-relaxed text-ink-soft">
    Repositories created in the window, counted at each star threshold.
  </p>

  <ul class="mt-7 space-y-6">
    {rows.map((row, index) => (
      <li>
        <div class="flex items-baseline justify-between gap-3">
          <span class="label text-ink-soft">{row.label}</span>
          <span class="num text-[1.5rem] leading-none text-ink">
            {formatCompact(row.total)}
          </span>
        </div>
        <div class="mt-2.5 flex items-center gap-3">
          <span class="h-[3px] flex-1 overflow-hidden bg-panel-2">
            <span
              class="bar"
              style={`--w:${Math.max(row.share * 100, 0.6).toFixed(2)}%;--i:${index}`}
            />
          </span>
          <span class="num w-12 text-right text-[0.6875rem] text-ink-faint">
            {formatPercent(row.share)}
          </span>
        </div>
      </li>
    ))}
  </ul>

  <p class="mt-6 border-t border-line-soft pt-4 text-[0.6875rem] leading-relaxed text-ink-faint">
    Tiers are nested: every repository in the ≥100 tier is also counted at ≥20
    and ≥2.
  </p>
</article>
