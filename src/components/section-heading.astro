---
interface Props {
  /** Editorial index, e.g. "01". */
  index: string
  title: string
  description?: string
  /** Right-aligned micro note, hidden on small screens. */
  aside?: string
}

const { index, title, description, aside } = Astro.props
---

<div class="mb-10 md:mb-14">
  <div class="flex items-baseline gap-4 border-t border-line pt-4">
    <span class="num text-[0.6875rem] text-accent">{index}</span>
    <h2 class="text-headline font-semibold text-ink">{title}</h2>
    {aside && (
      <span class="label ml-auto hidden text-right lg:block">{aside}</span>
    )}
  </div>
  {description && (
    <p class="mt-4 max-w-2xl text-meta leading-relaxed text-ink-soft md:text-body">
      {description}
    </p>
  )}
</div>
