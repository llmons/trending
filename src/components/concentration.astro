---
import { formatPercent } from "@/lib/format"

interface Props {
  top3Names: string[]
  top3Share: number
  top10Share: number
  remaining: number
}

const { top3Names, top3Share, top10Share, remaining } = Astro.props
---

<article class="breakdown md:col-span-6">
  <p class="label">Concentration</p>
  <h3 class="mt-3 text-title font-semibold text-ink">
    How top-heavy the year was
  </h3>
  <p class="mt-2 text-meta leading-relaxed text-ink-soft">
    Share of all new repositories (≥2 stars) held by the largest languages.
  </p>

  <dl class="mt-7 space-y-6">
    <div>
      <dt class="label text-ink-soft">Top 3 — {top3Names.join(", ")}</dt>
      <dd class="num mt-2 text-[2.25rem] leading-none text-ink">
        {formatPercent(top3Share)}
      </dd>
      <dd class="mt-2.5 h-[3px] overflow-hidden bg-panel-2">
        <span class="bar" style={`--w:${(top3Share * 100).toFixed(2)}%`} />
      </dd>
    </div>

    <div>
      <dt class="label text-ink-soft">Top 10</dt>
      <dd class="num mt-2 text-[2.25rem] leading-none text-ink">
        {formatPercent(top10Share)}
      </dd>
      <dd class="mt-2.5 h-[3px] overflow-hidden bg-panel-2">
        <span
          class="bar"
          style={`--w:${(top10Share * 100).toFixed(2)}%;--bar-color:var(--ink-faint)`}
        />
      </dd>
    </div>
  </dl>

  <p class="mt-6 border-t border-line-soft pt-4 text-[0.6875rem] leading-relaxed text-ink-faint">
    The remaining {remaining} tracked languages split the rest of the year's new
    repositories between them.
  </p>
</article>
