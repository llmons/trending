---
/**
 * Inline line-icon set. Hand-drawn paths on a 24px grid, stroked with
 * `currentColor` — no icon font, no runtime icon package.
 */
const ICONS = {
  "arrow-down": '<path d="M12 4v15"/><path d="m6 13 6 6 6-6"/>',
  "arrow-right": '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  "arrow-left": '<path d="M20 12H5"/><path d="m11 6-6 6 6 6"/>',
  "arrow-up-right": '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>',
  moon: '<path d="M20 14.2A8.2 8.2 0 0 1 9.8 4 8.2 8.2 0 1 0 20 14.2Z"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
} as const

type IconName = keyof typeof ICONS

interface Props {
  name: IconName
  size?: number
  class?: string
}

const { name, size = 16, class: className } = Astro.props
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>
